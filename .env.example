# ---- Railway service "api" (topology B) ----
DATABASE_URL=                       # injected by the Railway Postgres add-on (EU region)
EQAL_POLICY_PACK=ap
EQAL_PROVIDER=gateway
EQAL_GATEWAY_URL=https://api.mistral.ai
EQAL_GATEWAY_KEY=                   # Mistral key with a spend cap
EQAL_MODEL_L=mistral-small-latest
EQAL_MODEL_F=mistral-large-latest
EQAL_MODEL_M=mistral-medium-latest
EQAL_PROVIDER_REGION=eu
EQAL_PRICE_L_IN=0.15
EQAL_PRICE_L_OUT=0.60
EQAL_PRICE_F_IN=0.50
EQAL_PRICE_F_OUT=1.50
EQAL_PRICE_M_IN=1.50
EQAL_PRICE_M_OUT=7.50
EQAL_MATURITY_DAYS=30
EQAL_BOOTSTRAP_TENANT=demo
EQAL_BOOTSTRAP_API_KEY=             # long random string; this is the demo key shown on the site
EQAL_DEMO_TENANT=demo               # enables ?key= report links and /v1/demo/reset for this tenant only
EQAL_MAX_MODEL_CALLS_PER_DAY=3000   # ~EUR 1/day at Mistral prices
EQAL_MAX_UPLOAD_ROWS=3000
EQAL_MAX_REQ_PER_MIN=600
EQAL_CORS_ORIGINS=https://eqal.net,https://www.eqal.net
SENTRY_DSN=
